**/static/style.css
**/static/style.css.map

# macOS
.DS_Store

# Local Flourish SDK credentials
.flourish

# Claude Code local state
.claude/

# Working folder for new templates — kept out of the repo so the
# starter scaffolding stays clean while iterating.
New Flourish Templates/

# Environment / secrets
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / OS
.vscode/
.idea/
Thumbs.db

# Build / test output
dist/
build/
coverage/
