{
  "name": "scatter-basic",
  "version": "1.0.1-prerelease.6",
  "description": "A basic scatter chart template for Flourish",
  "main": "template.js",
  "author": "",
  "license": "ISC",
  "keywords": [
    "flourish"
  ],
  "scripts": {
    "build": "rollup -c",
    "build:prod": "NODE_ENV=production rollup -c",
    "watch": "rollup -c --watch",
    "less": "lessc --plugin=less-plugin-clean-css --source-map less/style.less static/style.css"
  },
  "dependencies": {
    "@flourish/chart-layout": "^11.0.1",
    "@flourish/colors": "^8.0.0",
    "@flourish/info-popup": "^8.3.0",
    "@flourish/layout": "^8.8.0",
    "@flourish/legend": "^6.4.0",
    "@flourish/number-formatter": "^2.0.0",
    "@flourish/number-localization": "^0.0.1",
    "d3-selection": "^3.0.0",
    "d3-transition": "^3.0.1"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^22.0.2",
    "@rollup/plugin-node-resolve": "^14.1.0",
    "@rollup/plugin-terser": "^0.4.4",
    "less": "^3.0.1",
    "less-plugin-clean-css": "^1.5.1",
    "rollup": "^2.79.0"
  }
}
